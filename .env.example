GROQ_API_KEY=your_key_here

# MongoDB Atlas (or local mongod). App degrades gracefully if unreachable.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=notaflop

# Optional — Redis (falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Optional — data sources (stubs work without these)
APIFY_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCT_HUNT_API_KEY=

# Optional — rate limiting (defaults shown)
RATE_LIMIT_SESSION_MAX=3
RATE_LIMIT_IP_MAX=15
RATE_LIMIT_WINDOW_SECONDS=86400

# Optional — Verifier shadow mode (default false; raw_score gates until flipped)
VERIFIER_PENALTY_ENABLED=false

# Required to use /internal/* endpoints (e.g. GET /internal/verifier/stats).
# Unset = those routes always 503 (fail closed, never open with no credential).
ADMIN_API_KEY=

# Optional — max transcript length in characters (default 5000)
TRANSCRIPT_MAX_LENGTH=5000

# development (default) | anything else (staging, production, ...).
# CORS_ALLOWED_ORIGINS is only optional when ENVIRONMENT=development —
# any other value REQUIRES it set, or the app refuses to start. See
# core/cors.py.
ENVIRONMENT=development
# Comma-separated allowed browser origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.notaflop.com,https://notaflop.com
CORS_ALLOWED_ORIGINS=
