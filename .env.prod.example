# D5: env vars for docker-compose.prod.yml. Copy to .env next to
# docker-compose.prod.yml and fill in. Individual service defaults are
# also documented in .env.example (backend) and frontend/.env.example.

# ── Backend ────────────────────────────────────────────────────────
GROQ_API_KEY=
MONGODB_DB=notaflop
ADMIN_API_KEY=
ENVIRONMENT=production
# Comma-separated, no spaces — the browser origins allowed to call this
# API. Required (non-empty) whenever ENVIRONMENT != development, see
# core/cors.py — the app refuses to start otherwise.
CORS_ALLOWED_ORIGINS=https://notaflop.com,https://www.notaflop.com
# Where magic-link emails point back to (must match the frontend's own
# public origin so /claim?token=... round-trips).
FRONTEND_BASE_URL=https://notaflop.com
SNAPSHOT_SCHEDULER_ENABLED=true

# ── Frontend (baked in at build time — see frontend/Dockerfile) ─────
NEXT_PUBLIC_API_BASE_URL=https://api.notaflop.com
NEXT_PUBLIC_SITE_URL=https://notaflop.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_COMING_SOON=false
